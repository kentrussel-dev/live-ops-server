# ========================================================
# Aetheria Live-Ops Console - Server Environment Config
# ========================================================

# Server Runtime Environment
NODE_ENV=development
PORT=4000

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/live_ops_console

# JWT Authentication Secret & Expiration
JWT_SECRET=your_super_secret_jwt_signing_key_here_change_in_production
JWT_EXPIRES_IN=30d

# Root Admin Master Secret Key (For Initial Bootstrap)
ROOT_ADMIN_KEY=AetheriaRootSecret2026!

# Allowed Client Origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# In-Memory Database Fallback for Testing / CI
ENABLE_MEMORY_DB_FALLBACK=true
